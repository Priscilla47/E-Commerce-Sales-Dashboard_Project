# Copy this file to .env and fill it in. .env is ignored by git; never commit a key.
# The AI features stay switched off while the key is empty; the rest of the project works without them.

# The provider to use. A provider has to be installed before it can be named here.
SALES_AI_PROVIDER=

# The model of that provider.
SALES_AI_MODEL=

# The secret key of the provider. Keep it empty to switch the AI features off.
SALES_AI_API_KEY=

# The most calls to the model one session may make (a whole number from 1 to 10000, 20 if unset).
SALES_AI_MAX_CALLS=20
